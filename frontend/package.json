    "check:full": "node scripts/check.mjs full"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "maplibre-gl": "6.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
